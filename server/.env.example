# Database connection string for PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/dental_academy

# JWT secret for session cookies
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1800s

# API server port
PORT=4000

# Allowed frontend origin for CORS and cookie requests
APP_ORIGIN=http://localhost:3000

# Default admin user (only created if no admin exists)
ADMIN_EMAIL=admin@rmo.local
ADMIN_PASSWORD=rmo2026
